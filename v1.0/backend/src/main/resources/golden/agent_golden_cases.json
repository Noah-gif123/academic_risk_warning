      "agent": "RecommendAgent",
      "studentId": 2,
      "courseId": 1,
      "expectedFields": ["plan"],
      "note": "推荐智能体必须产出可执行的学习计划"
    },
    {
      "caseId": "profile-student1-course1",
      "agent": "ProfileAgent",
      "studentId": 1,
      "courseId": 1,
      "expectedFields": ["knowledgeProfile", "habitProfile"],
