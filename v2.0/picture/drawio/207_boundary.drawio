<mxfile host="app.diagrams.net"><diagram name="图2.7 业务功能边界图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="学情预警系统（业务功能边界）" style="rounded=1;dashed=1;verticalAlign=top;html=1;fillColor=none;strokeColor=#4a5568;" vertex="1" parent="1"><mxGeometry x="300" y="44" width="490" height="566" as="geometry"/></mxCell><mxCell id="n3" value="① 教学数据采集：考勤录入（课表驱动点名单 / 批量导入 / 期中期末归档）、分项成绩与作业提交记录、覆盖率体检" style="whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="322" y="92" width="446" height="88" as="geometry"/></mxCell><mxCell id="n4" value="② 评价口径管理：成绩构成模板、评分项与权重、课程组确认与锁定、权重和校验" style="whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="322" y="196" width="446" height="74" as="geometry"/></mxCell><mxCell id="n5" value="③ 风险判定引擎：缺课硬门槛与期末需考判据、多源信号、课程难度 / 历史挂科率 / 教师尺度三因子校正、置信度与输出模式" style="whiteSpace=wrap;html=1;fillColor=#e8f7ee;strokeColor=#2f855a;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="322" y="286" width="446" height="104" as="geometry"/></mxCell><mxCell id="n6" value="④ 预警与干预闭环：预警生成与升级、通知与回执、干预记录、辅导员上报与教务终局处理" style="whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#c05621;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="322" y="406" width="446" height="88" as="geometry"/></mxCell><mxCell id="n7" value="⑤ 分析与智能体服务：三级挂科率报表、三维画像、归因解释与建议、课程知识库答疑" style="whiteSpace=wrap;html=1;fillColor=#f6f2ff;strokeColor=#6b46c1;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="322" y="510" width="446" height="74" as="geometry"/></mxCell><mxCell id="n8" value="学生 / 教师" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="96" width="110" height="100" as="geometry"/></mxCell><mxCell id="n9" value="辅导员 / 教务管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="110" height="100" as="geometry"/></mxCell><mxCell id="n10" value="上游：教务系统、一卡通门禁、在线教学平台（导出场名单与过程数据）" style="whiteSpace=wrap;html=1;fillColor=#f2f4f7;strokeColor=#4a5568;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="200" height="66" as="geometry"/></mxCell><mxCell id="n11" value="帮扶措施：谈话、补强练习、学习计划、资源推荐" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="200" height="74" as="geometry"/></mxCell><mxCell id="n12" value="管理动作：班会建议、重点关注班级、教务面谈" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="850" y="226" width="200" height="74" as="geometry"/></mxCell><mxCell id="n13" value="决策依据：三级挂科率报表、覆盖率督办清单" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="850" y="332" width="200" height="74" as="geometry"/></mxCell><mxCell id="n14" value="阿里云百炼：对话模型 + 课程知识库 RAG" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="855" y="440" width="195" height="96" as="geometry"/></mxCell><mxCell id="n15" value="边界之外（不属于本系统）：成绩归档与学籍处理、排课与收费、题库与练习推荐（v2 已取消）。本系统只负责“风险的发现、解释与帮扶流程的组织”，不替代教师评分与教务管理职能。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1010" height="64" as="geometry"/></mxCell><mxCell id="e16" value="录入" style="endArrow=open;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n8" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="处理" style="endArrow=open;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n9" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="导入" style="endArrow=open;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n10" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="HTTPS" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="真值注入" style="endArrow=open;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>