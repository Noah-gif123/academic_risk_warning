<mxfile host="app.diagrams.net"><diagram name="图2.8 部署配置图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="PC 浏览器：教师端 / 教务端 / 辅导员端" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="46" y="100" width="210" height="74" as="geometry"/></mxCell><mxCell id="n3" value="移动端浏览器：学生端" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="46" y="194" width="210" height="66" as="geometry"/></mxCell><mxCell id="n4" value="Spring Boot 4 应用（Java 17，内嵌 Tomcat，端口 8080）" style="whiteSpace=wrap;html=1;fillColor=#e8f7ee;strokeColor=#2f855a;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="330" y="96" width="412" height="60" as="geometry"/></mxCell><mxCell id="n5" value="四端控制器 + 鉴权（令牌 / 角色 / 数据范围）" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="196" height="60" as="geometry"/></mxCell><mxCell id="n6" value="确定性规则引擎 + 定时任务（体检 / 升级 / 催办）" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="546" y="170" width="196" height="60" as="geometry"/></mxCell><mxCell id="n7" value="多智能体编排 + 输出校验与反思" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="330" y="244" width="196" height="60" as="geometry"/></mxCell><mxCell id="n8" value="前端静态资源 dist（可由 Nginx 独立托管）" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="546" y="244" width="196" height="60" as="geometry"/></mxCell><mxCell id="n9" value="配置：application.properties（数据源、引擎参数、归档周次、智能体开关与超时）" style="whiteSpace=wrap;html=1;fillColor=#f2f4f7;strokeColor=#4a5568;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="330" y="318" width="412" height="58" as="geometry"/></mxCell><mxCell id="n10" value="MySQL 8  study_warning_system_v2（48 张表，端口 3306）" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="300" height="108" as="geometry"/></mxCell><mxCell id="n11" value="阿里云百炼 DashScope：对话模型 + 课程知识库（RAG 应用，按开课路由）" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="816" y="96" width="230" height="100" as="geometry"/></mxCell><mxCell id="n12" value="邮件服务 SMTP（可选）：预警与催办通知" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="816" y="216" width="230" height="70" as="geometry"/></mxCell><mxCell id="n13" value="文件存储：考勤 / 成绩导入模板与上传目录" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="816" y="302" width="230" height="74" as="geometry"/></mxCell><mxCell id="n14" value="构建与运行环境：JDK 17、Gradle 9、Node.js（前端构建）" style="whiteSpace=wrap;html=1;fillColor=#f2f4f7;strokeColor=#4a5568;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="816" y="392" width="230" height="70" as="geometry"/></mxCell><mxCell id="n15" value="部署说明：默认“前端构建产物打包进后端静态资源、只启动一个 8080 端口”的单体形态，便于答辩环境一键部署；若需前后端分离，可把 dist 交给 Nginx 托管，后端仅提供 REST 接口。数据库与外部服务（百炼）需可访问网络；智能体功能可由 agent.enabled 一键关闭，关闭后系统仍可独立完成数据采集与确定性预警。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2b6cb0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1030" height="60" as="geometry"/></mxCell><mxCell id="e16" value="HTTPS / JSON" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="JDBC 3306" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="HTTPS" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n4" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="读写文件" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n4" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="构建 / 部署" style="endArrow=open;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#4a5568;" edge="1" parent="1" source="n14" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>