# =============================================================================
# AI 通道配置模板
#   用法：复制成同目录的 ai.env（已被 .gitignore 忽略，不会入库），把值填上，
#   然后跑 run-ai.ps1 启动后端；或在 IDEA Run Configuration 里按同名变量填。
#
#   六个场景各自吃哪个 Key（看 /api/ai/health 的 scenes 字段即可确认）：
#     学习评价报告    DIFY(AI_REPORT_APP_KEY)  → 没有则用直连 → 没有则模板
#     预警解释卡      DIFY(AI_ALERT_APP_KEY)   → 没有则用直连 → 没有则模板
#     群体报告        DIFY(AI_GROUP_REPORT_APP_KEY) → 直连 → 模板
#     AI 批改建议     只能用直连（代码里没有 Dify 分支）
#     AI 出题         只能用直连
#     课程问答       只能用直连（本地检索 + 模型作答，无依据则拒答）
#   所以：只有 Dify 五个 Key 也能跑报告/解释卡/群体报告；要全场景真实，必须有一个直连 Key。
# =============================================================================

# ---------- 直连通道（推荐 / 主力）：任意 OpenAI 兼容端点 ----------
# 阿里云百炼 DashScope：
AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_LLM_KEY=sk-在这里填你的key
AI_LLM_MODEL=qwen-plus

# DeepSeek（换成这三行即可，价格便宜很多）：
#AI_LLM_BASE_URL=https://api.deepseek.com/v1
#AI_LLM_KEY=sk-在这里填你的key
#AI_LLM_MODEL=deepseek-chat

# ---------- Dify 自托管（可选）：Dify 起在 8090 且配好工作流时才需要 ----------
AI_DIFY_BASE_URL=http://localhost:8090
# 报告工作流（学生端学习评价）
AI_REPORT_APP_KEY=
# AI 出题工作流
AI_QUESTION_APP_KEY=
# 课程问答工作流（不配则走直连 + 本地检索）
AI_CHAT_APP_KEY=
# 预警解释卡工作流（不配则走直连）
AI_ALERT_APP_KEY=
# 群体报告工作流（不配则走直连）
AI_GROUP_REPORT_APP_KEY=

# ---------- 开关与限额（可选） ----------
# 关掉 AI：所有入口回退规则模板
#AI_ENABLED=false
# 每个用户每个场景每日上限
#AI_DAILY_LIMIT=30
