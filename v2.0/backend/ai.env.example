# =============================================================================
# AI 通道配置模板
#   用法：复制成同目录的 ai.env（已被 .gitignore 忽略，不会入库），把值填上，
#   然后跑 run-ai.ps1 启动后端；或在 IDEA Run Configuration 里按同名变量填。
#   只填「直连通道」三项就够让 6 个 AI 场景全部真跑；Dify 那几项是可选增强。
# =============================================================================

# ---------- 直连通道（推荐 / 主力）：任意 OpenAI 兼容端点 ----------
# 阿里云百炼 DashScope：
AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_LLM_KEY=sk-在这里填你的key
AI_LLM_MODEL=qwen-plus

# DeepSeek（换成这三行即可，价格便宜很多）：
#AI_LLM_BASE_URL=https://api.deepseek.com/v1
#AI_LLM_KEY=sk-在这里填你的key
#AI_LLM_MODEL=deepseek-chat

# ---------- Dify 自托管（可选）：Dify 起在 8090 且配好工作流时才需要 ----------
AI_DIFY_BASE_URL=http://localhost:8090
# 报告工作流（学生端学习评价）
AI_REPORT_APP_KEY=
# AI 出题工作流
AI_QUESTION_APP_KEY=
# 课程问答工作流（不配则走直连 + 本地检索）
AI_CHAT_APP_KEY=
# 预警解释卡工作流（不配则走直连）
AI_ALERT_APP_KEY=
# 群体报告工作流（不配则走直连）
AI_GROUP_REPORT_APP_KEY=

# ---------- 开关与限额（可选） ----------
# 关掉 AI：所有入口回退规则模板
#AI_ENABLED=false
# 每个用户每个场景每日上限
#AI_DAILY_LIMIT=30
