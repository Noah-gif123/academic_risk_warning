    { "f": "enroll", "to": "att", "k": "assoc", "lf": "1", "lt": "N" },
    { "f": "session", "to": "att", "k": "assoc", "lf": "1", "lt": "N" },
    { "f": "enroll", "to": "score", "k": "assoc", "lf": "1", "lt": "N" },
    { "f": "enroll", "to": "risk", "k": "assoc", "lf": "1", "lt": "1" },
    { "f": "risk", "to": "alert", "k": "assoc", "lf": "1", "lt": "N", "l": "达到阈值", "lw": 110 },
    { "f": "alert", "to": "inter", "k": "assoc", "lf": "1", "lt": "N" },
