# v3.0 一键栈环境变量（复制为 v3.0/.env 使用）
DB_ROOT_PASSWORD=root
AI_ENABLED=true
# 仅本地验收/P1 脚本使用；录制和公网演示保持 false
CAPTCHA_DEBUG=false
# 直连模型（任选一个 OpenAI 兼容端点；不填则报告走规则模板）
AI_LLM_BASE_URL=https://api.deepseek.com/v1
AI_LLM_KEY=
AI_LLM_MODEL=deepseek-chat
# Dify（可选）
AI_DIFY_BASE_URL=http://host.docker.internal:8090
AI_GROUP_REPORT_APP_KEY=
AI_REPORT_APP_KEY=
AI_ALERT_APP_KEY=
AI_QUESTION_APP_KEY=
AI_CHAT_APP_KEY=
